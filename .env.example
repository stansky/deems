# Server-only configuration. Never commit real values.
DATABASE_URL=postgres://deems:change-me@127.0.0.1:5432/deems
DEEMS_OPENAI_MODEL=gpt-6-luna
DEEMS_OPENAI_KEY=
OPENAI_PROJECT_ID=
DEEMS_TYPESAFE_KEY=
# Set only after Vercel Authentication protects ALL deployments and storage is ready.
DEEMS_HOSTED_READY=false

# Hosted Cognito access (use a distinct client and secret in each environment).
DEEMS_COGNITO_REGION=us-west-1
DEEMS_COGNITO_USER_POOL_ID=
DEEMS_COGNITO_CLIENT_ID=
DEEMS_COGNITO_ALLOWED_SUBS=
DEEMS_AUTH_SECRET=
# Optional local authentication needs HTTPS for secure cookies.
DEEMS_AUTH_ENABLED=false
